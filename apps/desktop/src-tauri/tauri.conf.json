{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Img2Model AMD",
  "version": "0.1.0",
  "identifier": "dev.quendae.img2modelamd",
  "build": {
    "beforeDevCommand": "npm run sync-dev-runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-installer && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Img2Model AMD",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$TEMP/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/installer-payload/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["English", "Polish"]
      }
    }
  }
}
